{
  "name": "rove-log-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blueprintjs/core": "^5.10.5",
    "@blueprintjs/datetime2": "^2.3.7",
    "@blueprintjs/icons": "^5.10.0",
    "@blueprintjs/select": "^5.2.0",
    "date-fns": "^2.30.0",
    "express": "^4.19.2",
    "react-day-picker": "^8.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.31",
    "ws": "^8.17.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
