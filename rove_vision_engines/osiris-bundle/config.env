# Osiris bundle configuration.
# Edit a value, then re-run ./run.sh  (or: sudo systemctl restart osiris-bundle).

# REST + WebSocket API address (host:port). Change the port to avoid conflicts.
OSIRIS_BIND=0.0.0.0:9092

# WebRTC gateway (MediaMTX) ports.
OSIRIS_RTSP_PORT=8554      # API reads republished streams here
OSIRIS_WEBRTC_PORT=8889    # WebRTC/WHIP ingest (publish to http://host:PORT/<stream>/whip)

# Preview tool (./preview.sh) web port.
PREVIEW_PORT=8080
